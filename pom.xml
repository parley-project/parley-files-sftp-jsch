<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-sftp-jsch</artifactId>
	<version>1.0.0</version>
	<name>Parley Files SFTP: JSch</name>
	<description>The JSch provider for parley-files-sftp (the maintained com.github.mwiede fork). LIMITATION: JSch cannot write at a position in a file, so writing to a random access stream throws an IOException; everything else, including random access reading, works. Use another provider (parley-files-sftp-parley-ssh or -mina) if the application writes at positions.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.sftp.jsch</parley.moduleName>
		<parley.version>1.0.0</parley.version>
	</properties>

	<!-- GitHub Packages. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-files-sftp-jsch</url>
		</repository>
	</distributionManagement>

	<build>
		<plugins>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Runs parley-files-sftp's provider test suite (its tests jar) against this provider,
			     with this project's own tests. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<dependenciesToScan>
						<dependency>us.bringardner.parley:parley-files-sftp</dependency>
					</dependenciesToScan>
					<systemPropertyVariables>
						<!-- What this library can't do (see the README): the suite skips those tests;
						     this project's own tests check that the provider refuses them. -->
						<parley.sftp.test.unsupported>writeAtPosition</parley.sftp.test.unsupported>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- Maintained JSch fork: modern key types and algorithms; same com.jcraft.jsch packages -->
		<dependency>
			<groupId>com.github.mwiede</groupId>
			<artifactId>jsch</artifactId>
			<version>2.28.7</version>
		</dependency>

		<!-- The provider test suite and what it needs -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${parley.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.13.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-synergy-server</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-session</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-filesystem</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<!-- A parley-ssh server for the ssh-agent test (it registers no provider) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-ssh</artifactId>
			<version>${parley.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- On Windows the suite's embedded server is MINA's (it registers no provider) -->
		<dependency>
			<groupId>org.apache.sshd</groupId>
			<artifactId>sshd-sftp</artifactId>
			<version>2.19.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
